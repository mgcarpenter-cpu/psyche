{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/front-v2",
      "permanent": false
    },
    {
      "source": "/how-it-works",
      "destination": "/give-a-gift",
      "permanent": false
    },
    {
      "source": "/how-it-works.html",
      "destination": "/give-a-gift",
      "permanent": false
    },
    {
      "source": "/practice",
      "destination": "/goals-schedule",
      "permanent": false
    },
    {
      "source": "/practice.html",
      "destination": "/goals-schedule",
      "permanent": false
    },
    {
      "source": "/your-plan",
      "destination": "/give-a-gift",
      "permanent": false
    },
    {
      "source": "/your-plan.html",
      "destination": "/give-a-gift",
      "permanent": false
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/g.js": {
      "includeFiles": "{front-v2.html,meditation-sessions.js}"
    },
    "api/gift.js": {
      "includeFiles": "meditation-sessions.js"
    },
    "api/gift-image.js": {
      "includeFiles": "{fonts/**,gift-card.js,meditation-sessions.js}"
    }
  },
  "rewrites": [
    {
      "source": "/g/:id",
      "destination": "/api/g?id=:id"
    }
  ]
}

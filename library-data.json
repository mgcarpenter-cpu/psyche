[
  { "id": "p-001", "type": "video", "pearlText": "You want to be free. Then let go.", "videoUrl": "videos/02_card_wolf_pearl.mp4", "arrived": 210, "joined": 9, "section": "hot" },
  { "id": "p-002", "type": "pearl", "pearlText": "What we resist persists; what we meet, passes.", "videoUrl": null, "arrived": 165, "joined": 6, "section": "hot" },
  { "id": "p-003", "type": "video", "pearlText": "The river doesn’t ask you to jump.", "videoUrl": "videos/04_card_ig_wolf_post.mp4", "arrived": 132, "joined": 4, "section": "hot" },

  { "id": "p-004", "type": "video", "pearlText": "You want to be free. Then let go.", "videoUrl": "videos/02_card_wolf_pearl.mp4", "arrived": 40, "joined": 0, "section": "new" },
  { "id": "p-005", "type": "pearl", "pearlText": "The wanting is louder than the thing.", "videoUrl": null, "arrived": 55, "joined": 1, "section": "new" },
  { "id": "p-006", "type": "pearl", "pearlText": "Meet the feeling. Don’t grab it.", "videoUrl": null, "arrived": 22, "joined": 0, "section": "new" },

  { "id": "p-007", "type": "video", "pearlText": "What you resist, you carry.", "videoUrl": "videos/04_card_ig_wolf_post.mp4", "arrived": 118, "joined": 3, "section": "library" },
  { "id": "p-008", "type": "pearl", "pearlText": "The mind clings; the breath lets go.", "videoUrl": null, "arrived": 96, "joined": 2, "section": "library" },
  { "id": "p-009", "type": "video", "pearlText": "Stillness is full and quiet.", "videoUrl": "videos/02_card_wolf_pearl.mp4", "arrived": 130, "joined": 5, "section": "library" },
  { "id": "p-010", "type": "pearl", "pearlText": "You are the sky the storm moves through.", "videoUrl": null, "arrived": 64, "joined": 1, "section": "library" },
  { "id": "p-011", "type": "video", "pearlText": "Wanting less is a kind of wealth.", "videoUrl": "videos/04_card_ig_wolf_post.mp4", "arrived": 88, "joined": 2, "section": "library" },
  { "id": "p-012", "type": "pearl", "pearlText": "The path is under your feet already.", "videoUrl": null, "arrived": 120, "joined": 1, "section": "library" }
